# ── PayPal Orders v2 ─────────────────────────────────────────────
# Create a sandbox app at https://developer.paypal.com/dashboard/applications
# Leave blank to run the built-in simulated sandbox (no network needed).
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox

# Channel3 product search API key. Keep this value server-side.
CHANNEL3_API_KEY=

# ── Optional LLM intent extraction ───────────────────────────────
# Without a key the deterministic parser handles every demo prompt.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-3-5-haiku-latest

# ── Server ───────────────────────────────────────────────────────
PORT=8787
